# Keep these folders in git (through an empty .gitkeep file),
# but never upload anything else inside them.
input/*
!input/.gitkeep
output/*
!output/.gitkeep
context/*
!context/.gitkeep

# Run results, in case they are created somewhere else
Run_*/
debug/

# Drawings and result files
*.pdf
*.xlsx
*.xls
*.csv

# Python cache and virtual environment
__pycache__/
.venv/
venv/

# IDE files
.vscode/
.idea/

# OS files
Thumbs.db
.DS_Store

# Temporary files
*.tmp
*.temp
*.log
